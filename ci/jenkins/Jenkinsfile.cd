/* CD GitOps : inscrit dans Git la version Nexus à désirer dans Kubernetes. */
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 15, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Tag Nexus obligatoire, par exemple 42-a1b2c3d4')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Overlay Kubernetes à promouvoir')
    booleanParam(name: 'PUSH_GITOPS', defaultValue: true, description: 'Créer et pousser le commit GitOps')
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Valider la promotion') {
      steps {
        script {
          if (!(params.IMAGE_TAG ==~ /[A-Za-z0-9][A-Za-z0-9._-]{0,127}/)) {
            error('IMAGE_TAG est vide ou invalide.')
          }
          env.OVERLAY_FILE = "infrastructure/k8s/overlays/${params.ENVIRONMENT}/kustomization.yaml"
          if (!fileExists(env.OVERLAY_FILE)) {
            error("Overlay Kubernetes introuvable : ${env.OVERLAY_FILE}")
          }
          currentBuild.description = "${params.IMAGE_TAG} → ${params.ENVIRONMENT}"
        }
      }
    }
    stage('Mettre à jour GitOps') {
      steps {
        script {
          def manifest = readFile(env.OVERLAY_FILE)
          manifest = manifest.replaceAll(/newTag: [^\r\n]+/, "newTag: ${params.IMAGE_TAG}")
          writeFile file: env.OVERLAY_FILE, text: manifest
        }
        sh 'kubectl kustomize "infrastructure/k8s/overlays/$ENVIRONMENT" > /tmp/stb-rendered.yaml'
        archiveArtifacts artifacts: 'infrastructure/k8s/overlays/**/kustomization.yaml', fingerprint: true
      }
    }
    stage('Commit GitOps') {
      when { expression { params.PUSH_GITOPS } }
      steps {
        withCredentials([gitUsernamePassword(credentialsId: 'git-credentials', gitToolName: 'Default')]) {
          sh '''git config user.name "STB Jenkins"
git config user.email "stb-jenkins@local"
git add "$OVERLAY_FILE"
if git diff --cached --quiet; then
  echo "La version demandée est déjà enregistrée dans Git."
else
  git commit -m "[gitops] Deploy $IMAGE_TAG to $ENVIRONMENT"
  git push origin HEAD:main
fi'''
        }
      }
    }
  }
}
