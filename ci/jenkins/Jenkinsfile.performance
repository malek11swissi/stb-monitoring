/* Job manuel : test de charge léger sans modifier les données métier. */
pipeline {
  agent any
  options { timestamps(); timeout(time: 15, unit: 'MINUTES') }
  stages {
    stage('Test k6') {
      steps {
        sh '''JENKINS_NETWORK=$(docker inspect stb-monitoring-jenkins --format '{{range $name, $config := .NetworkSettings.Networks}}{{$name}}{{"\\n"}}{{end}}' | head -n 1)
docker run --rm --network "$JENKINS_NETWORK" grafana/k6:latest run - <<'EOF'
import http from 'k6/http';
import { check, sleep } from 'k6';
export const options = { vus: 5, duration: '30s', thresholds: { http_req_failed: ['rate<0.01'], http_req_duration: ['p(95)<1000'] } };
export default function () {
  check(http.get('http://api:8080/health'), { 'API UP': r => r.status === 200 });
  sleep(1);
}
EOF'''
      }
    }
  }
}
