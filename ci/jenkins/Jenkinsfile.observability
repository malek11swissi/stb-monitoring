/* Contrôle manuel ou post-déploiement des ressources Kubernetes. */
pipeline {
  agent any
  options { timestamps(); timeout(time: 10, unit: 'MINUTES') }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Environnement Kubernetes à contrôler')
    booleanParam(name: 'CHECK_MONITORING', defaultValue: true, description: 'Vérifier aussi Prometheus et Grafana locaux')
  }
  stages {
    stage('Kubernetes') {
      steps {
        sh '''kubectl get namespace "stb-$ENVIRONMENT"
kubectl -n "stb-$ENVIRONMENT" rollout status deployment/stb-api --timeout=180s
kubectl -n "stb-$ENVIRONMENT" rollout status deployment/stb-frontend --timeout=180s
kubectl -n "stb-$ENVIRONMENT" rollout status deployment/stb-ai-service --timeout=180s
kubectl -n "stb-$ENVIRONMENT" get pods,services'''
      }
    }
    stage('Prometheus et Grafana') {
      when { expression { params.CHECK_MONITORING } }
      steps {
        sh '''curl --fail --silent http://prometheus:9090/-/ready
curl --fail --silent http://grafana:3000/api/health'''
      }
    }
  }
}
